# Codex Pool Proxy Configuration

# Network & Server
PROXY_LISTEN_ADDR=0.0.0.0:8989
# ADMIN_TOKEN=your-secure-admin-token
# FRIEND_CODE=your-friend-invite-code

# Storage & Database Paths (inside container)
POOL_DIR=/app/pool
PROXY_DB_PATH=/app/data/proxy.db
DUCKDB_PATH=/app/data/usage.duckdb

# Tuning & Limits
PROXY_MAX_ATTEMPTS=3
PROXY_USAGE_REFRESH_SECONDS=300
# IP access policy (comma-separated IPs/CIDRs; deny wins over allow; loopback
# is always permitted; empty = unrestricted). Also settable in config.toml as
# ip_access_allow / ip_access_deny.
# PROXY_IP_ALLOW=10.0.0.0/8,192.168.1.5
# PROXY_IP_DENY=203.0.113.0/24
# IP privacy: stop persisting raw client IPs (wipes stored values at startup)
# and hash IPs in route traces. Origin analytics keep working on salted hashes.
PROXY_IP_PRIVACY=true
# Rotate the origin hash salt per window in hours (0 = stable forever, which
# preserves long-term anonymous attribution).
# PROXY_ORIGIN_HASH_WINDOW_HOURS=168
# Prune origin metadata older than N days (0 = keep forever).
# PROXY_ORIGIN_RETENTION_DAYS=180
# Hold requests up to this long when all accounts of a type are usage-exhausted
# (5h/weekly window at the hard-exclude thresholds) instead of failing with 503.
# 0 disables the hold.
PROXY_EXHAUSTION_WAIT_SECONDS=900
# When the window reset fits inside that hold budget, keep the request on the
# original provider instead of switching to a fallback model mid-conversation.
PROXY_EXHAUSTION_PREFER_WAIT=true
PROXY_USAGE_RETENTION_DAYS=30
DUCKDB_MEMORY_LIMIT=512MB
# PROXY_DEBUG=true
