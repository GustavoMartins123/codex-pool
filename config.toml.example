# Codex Pool Proxy Configuration
# Copy this file to config.toml and customize as needed.
# Environment variables take precedence over config file values.

# Server settings
listen_addr = "127.0.0.1:8989"
pool_dir = "pool"
db_path = "./data/proxy.db"
max_attempts = 3
disable_refresh = false
debug = false
# Max request body size to buffer in memory before streaming (bytes).
# Set via env PROXY_MAX_INMEM_BODY_BYTES (default 16777216).

# Public URL for generated configs and instructions
# Use this when behind a reverse proxy or using a custom domain
# Example: "https://proxy.example.com" or "http://192.168.1.100:8989"
public_url = ""

# Grok Code upstream and accounts
# Accounts are loaded from pool/grok/*.json. You can paste/import ~/.grok auth JSON
# from the friend admin page, or place pi-grok/simple auth JSON in that directory.
grok_base = "https://cli-chat-proxy.grok.com/v1"

# Final metadata-only import of the retired pool-user store. When present at
# boot, identities not yet in Passport are imported as guest principals; the
# old tokens never authenticate. After the one-shot retirement completes, this
# file is ignored forever.
[pool_users]
# Secret key retained for validating existing signed client credentials.
jwt_secret = ""

# Where to store pool user data
storage_path = "./data/pool_users.json"

# Optional model name aliases (short name -> upstream model).
# Built-in defaults always include: gpt-5.6 -> gpt-5.6-sol
# Entries here override built-ins.
# [model_aliases]
# "gpt-5.6" = "gpt-5.6-sol"

# --- Security (CP-01) -------------------------------------------------------
# Forwarded client-IP headers (CF-Connecting-IP, X-Forwarded-For, X-Real-IP)
# are only honored when the peer address matches this list. An entry may be a
# single address or a CIDR; "*"/"all" trusts every peer. When unset, only
# loopback peers are trusted, so a direct client cannot spoof its origin.
# Env: PROXY_TRUSTED_PROXIES (or TRUSTED_PROXIES).
# trusted_proxies = ["10.0.0.0/8", "192.168.1.5"]

# Per-client access policy. Deny always wins over allow, and loopback is always
# permitted so container health checks and local admin tooling keep working.
# An empty allow list leaves the pool unrestricted. Env: PROXY_IP_ALLOW,
# PROXY_IP_DENY (comma-separated).
# ip_access_allow = ["10.0.0.0/8"]
# ip_access_deny  = ["203.0.113.0/24"]

# IP privacy. When on, raw client IPs are not persisted (any stored values are
# wiped at startup) and route traces carry a salted hash instead. Analytics
# join on that hash, so per-origin reporting keeps working without the PII.
# Env: PROXY_IP_PRIVACY. Defaults to true; set false to keep raw IPs.
# ip_privacy = true

# Rotate the origin hash salt on this window so hashes cannot be correlated
# across windows while daily/weekly analytics stay joinable inside one window.
# 0 keeps the salt stable forever. Env: PROXY_ORIGIN_HASH_WINDOW_HOURS.
# origin_hash_window_hours = 168

# Drop origin metadata older than this many days. 0 keeps everything.
# Env: PROXY_ORIGIN_RETENTION_DAYS.
# origin_retention_days = 180

# --- Credential vault (CP-02) ----------------------------------------------
# Upstream credentials in pool/<provider>/<account>.json are encrypted at rest
# when POOL_CREDENTIAL_KEY is set (64 hex chars, or a passphrase of at least 32
# characters). Set before the first start: plaintext files are migrated to
# encrypted at startup, and an encrypted pool with no key fails closed instead
# of loading as empty. Rotate by moving the current key to
# POOL_CREDENTIAL_KEY_PREVIOUS and bumping POOL_CREDENTIAL_KEY_VERSION; rollback
# with the -decrypt-credentials flag. See README "Security hardening".

# Smart Router policy. Requests may override this with:
#   X-Pool-Routing: fast
# or model aliases such as pool/quota-saver/gpt-5.6.
[routing]
default_profile = "balanced"
default_model = "gpt-5.5"

# Built-in profiles: balanced, fast, throughput, quota-saver, drain, sticky.
# Set default_profile = "legacy" to retain the pre-Smart-Router selector.
# A complete profile whose weights total 1 replaces the built-in weights.
[routing.profiles.balanced]
quota_headroom = 0.25
reset_urgency = 0.15
health = 0.20
ttft = 0.10
throughput = 0.10
affinity = 0.10
inflight = 0.05
recent_failure = 0.05

# Optional per-client policies. The key may be a client credential ID, its
# case-insensitive label, or "*" for the default policy.
[client_policies.workstation]
priority = 50

[client_policies.workstation.models]
allow = ["gpt-5.6-sol", "gpt-6-astra"]

[client_policies.workstation.providers]
deny = ["grok"]

[client_policies.workstation.limits]
requests_per_minute = 30
concurrent_requests = 3
daily_requests = 1000
daily_tokens = 3000000
monthly_tokens = 60000000

[client_policies.workstation.routing]
profile = "balanced"

# Configuration-driven OpenAI-compatible provider. The token is read only from
# the environment and is never returned by pool APIs.
[providers.local-vllm]
protocol = "openai"
base_url = "http://192.168.1.50:8000/v1"

[providers.local-vllm.auth]
type = "bearer"
token_env = "VLLM_TOKEN"

[providers.local-vllm.health]
path = "/models"
interval_seconds = 30

[[providers.local-vllm.models]]
id = "qwen"
name = "Qwen Local"
context_window = 262144
max_output_tokens = 32768
reasoning = true
modalities = ["text"]
fallbacks = ["gpt-5.6-luna"]
fallback_for = ["gpt-5.6-luna"]

# Deterministic canary routing. This sends 5% of conversations requesting
# gpt-5.6-sol to gpt-6-astra. Shadow duplication is opt-in and only runs for
# requests without tools or image generation.
[experiments.canary."gpt-5.6-sol"]
candidate = "gpt-6-astra"
percent = 5
shadow = false

# Optional authenticated pool federation. The remote token is a normal client
# credential issued by the remote node and is read only from the environment.
[federation]
enabled = false

[federation.nodes.home]
enabled = true
base_url = "https://pool-home.example.com"
token_env = "POOL_HOME_TOKEN"
poll_interval_seconds = 30
