{
  "name": "provider_switch",
  "description": "Switching provider between requests with conversation state",
  "steps": [
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "model": "gpt-5.6-sol",
        "conversation_id": "bench-prov-switch-conv",
        "messages": [
          {
            "role": "user",
            "content": "Hello from provider 1"
          }
        ],
        "stream": false
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "model": "antigravity/gemini-3.8-flash-high",
        "conversation_id": "bench-prov-switch-conv",
        "messages": [
          {
            "role": "user",
            "content": "Hello from provider 2"
          }
        ],
        "stream": false
      }
    }
  ]
}
