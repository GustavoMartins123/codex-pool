# Codex Pool Proxy Configuration
#
# Operator-relevant variables only. Everything optional is shown commented
# with its default. Dev/bench/test-only variables (ANALYTICS_BENCH_*,
# POOL_RELEASE_REPLAY_*, OPENCODE_GO_LIVE, CODEX_APP_* fingerprint fixtures)
# are intentionally not listed.

# ----------------------------------------------------------------------------
# Bootstrap secrets (generate with: openssl rand -hex 32)
# ----------------------------------------------------------------------------

# Required to create the first operator.
# ADMIN_TOKEN=<64-hex-chars>
# Stable Passport sealing key.
# POOL_AUTH_ENCRYPTION_KEY=<64-hex-chars>
# Offline migration only: previous key, used just once by
#   docker compose run --rm --no-deps codex-pool -rotate-passport-key
# POOL_AUTH_ENCRYPTION_KEY_OLD=<former-key>
# Stable signing key for client credentials.
# POOL_JWT_SECRET=<64-hex-chars>

# ----------------------------------------------------------------------------
# Network & reverse proxy
# ----------------------------------------------------------------------------

PROXY_LISTEN_ADDR=0.0.0.0:8989
# Trust X-Forwarded-For from these IPs/CIDRs (required when behind a reverse
# proxy, or client IPs and brute-force bans see the proxy instead).
# PROXY_TRUSTED_PROXIES=10.0.0.0/8,172.16.0.5
# Legacy alias for PROXY_TRUSTED_PROXIES.
# TRUSTED_PROXIES=
# Trust forwarded headers from any peer on the same container network
# (compose.traefik.yml sets this automatically).
# PROXY_TRUST_SAME_SUBNET=true
# Public base URL used when issuing absolute links (join/recovery), instead
# of deriving it from the request host.
# PUBLIC_URL=https://pool.example.com
# Path to the TOML config file (default: config.toml next to the binary).
# CONFIG_PATH=/app/config.toml

# IP access policy (comma-separated IPs/CIDRs; deny wins over allow; loopback
# is always permitted; empty = unrestricted). Also settable in config.toml as
# ip_access_allow / ip_access_deny.
# PROXY_IP_ALLOW=10.0.0.0/8,192.168.1.5
# PROXY_IP_DENY=203.0.113.0/24

# ----------------------------------------------------------------------------
# Traefik deployment (used with compose.traefik.yml only)
# ----------------------------------------------------------------------------

# POOL_DOMAIN=pool.example.com
# TRAEFIK_NETWORK=your-traefik-network
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=your-certificate-resolver

# ----------------------------------------------------------------------------
# Storage (paths are inside the container for Docker deployments)
# ----------------------------------------------------------------------------

POOL_DIR=/app/pool
PROXY_DB_PATH=/app/data/proxy.db
DUCKDB_PATH=/app/data/usage.duckdb
# Legacy SQLite analytics database (default: analytics.db next to proxy.db).
# ANALYTICS_DB_PATH=/app/data/analytics.db
# Pool users store (default: ./data/pool_users.json).
# POOL_USERS_PATH=/app/data/pool_users.json

# ----------------------------------------------------------------------------
# Credential vault (encrypt pool/<provider>/*.json at rest, AES-256-GCM)
# ----------------------------------------------------------------------------

# Key forms: 64 hex chars (used verbatim) or a passphrase of 32+ chars.
# Plaintext files are encrypted automatically at startup; with a key set the
# pool fails to start if any file cannot be decrypted.
# Generate with: openssl rand -hex 32
# POOL_CREDENTIAL_KEY=<64-hex-chars-or-long-passphrase>
# POOL_CREDENTIAL_KEY_VERSION=1
# Rotation window: keep the old key here while startup re-encrypts files.
# POOL_CREDENTIAL_KEY_PREVIOUS=<old-key>
# POOL_CREDENTIAL_KEY_PREVIOUS_VERSION=1
# Rollback to plaintext files: run with -decrypt-credentials (needs the key).

# ----------------------------------------------------------------------------
# Routing, retries & exhaustion
# ----------------------------------------------------------------------------

PROXY_MAX_ATTEMPTS=3
# Hold requests up to this long when all accounts of a type are usage-exhausted
# (5h/weekly window at the hard-exclude thresholds) instead of failing with 503.
# 0 disables the hold.
PROXY_EXHAUSTION_WAIT_SECONDS=900
# When the window reset fits inside that hold budget, keep the request on the
# original provider instead of switching to a fallback model mid-conversation.
PROXY_EXHAUSTION_PREFER_WAIT=true
# Secondary usage % at which a tier stops being preferred (default 50%).
# TIER_THRESHOLD=0.50
# Extra per-turn pacing delay in milliseconds (0 = disabled).
# CODEX_REQUEST_PACE_MS=0
# Disable the background quota-intelligence refresher.
# PROXY_ENABLE_QUOTA_INTELLIGENCE=0

# ----------------------------------------------------------------------------
# Timeouts & streaming (0 = disabled, which is the default for the hard
# timeouts so long-running jobs can finish)
# ----------------------------------------------------------------------------

# PROXY_REQUEST_TIMEOUT_SECONDS=0
# PROXY_STREAM_TIMEOUT_SECONDS=0
# Kill SSE streams idle for longer than this (0 = never).
# STREAM_IDLE_TIMEOUT_SECONDS=0
# WEBSOCKET_IDLE_TIMEOUT_SECONDS=0
# WEBSOCKET_HEARTBEAT_SECONDS=15
# WEBSOCKET_READ_LIMIT_BYTES=67108864
# Enable WebSocket compression.
# WEBSOCKET_COMPRESSION=true
# Batch SSE flushes at most every N milliseconds (0 = flush every write).
# PROXY_FLUSH_INTERVAL_MS=0
# Grace period for in-flight requests on shutdown (default 30s).
# PROXY_SHUTDOWN_GRACE_SECONDS=30

# ----------------------------------------------------------------------------
# Body limits & tracing
# ----------------------------------------------------------------------------

# In-memory request body ceiling before spooling to disk (default 16 MiB).
# PROXY_MAX_INMEM_BODY_BYTES=16777216
# Disk-backed request body ceiling (default 1 GiB).
# PROXY_MAX_SPOOL_BODY_BYTES=1073741824
# Log request/response bodies when debug logging is on.
# PROXY_LOG_BODIES=1
# PROXY_BODY_LOG_LIMIT=16384
# Dump Claude upstream exchanges to JSON files under this directory.
# PROXY_CLAUDE_TRACE_DIR=/app/data/claude-trace
# PROXY_CLAUDE_TRACE_BODY_LIMIT=262144
# Include auth material in Claude traces (off by default).
# PROXY_CLAUDE_TRACE_INCLUDE_SECRETS=0
# Dump image-generation request traces under this directory.
# PROXY_IMAGE_TRACE_DIR=/app/data/image-trace

# ----------------------------------------------------------------------------
# Usage, retention & analytics
# ----------------------------------------------------------------------------

PROXY_USAGE_REFRESH_SECONDS=300
PROXY_USAGE_RETENTION_DAYS=30
DUCKDB_MEMORY_LIMIT=512MB
# Cap DuckDB at one connection and minimal settings for small hosts.
# DUCKDB_LOW_MEMORY=1
# Disk reserve kept free for DuckDB checkpoint headroom (default 64 MiB).
# ANALYTICS_EMERGENCY_RESERVE_BYTES=67108864
# IP privacy: stop persisting raw client IPs (wipes stored values at startup)
# and hash IPs in route traces. Origin analytics keep working on salted hashes.
PROXY_IP_PRIVACY=true
# Rotate the origin hash salt per window in hours (0 = stable forever, which
# preserves long-term anonymous attribution).
# PROXY_ORIGIN_HASH_WINDOW_HOURS=168
# Prune origin metadata older than N days (0 = keep forever).
# PROXY_ORIGIN_RETENTION_DAYS=180

# ----------------------------------------------------------------------------
# Upstream identity & egress
# ----------------------------------------------------------------------------

# Outbound proxy for token refresh traffic.
# REFRESH_PROXY_URL=http://user:pass@proxy:8080
# Outbound proxy for all Codex upstream traffic.
# CODEX_PROXY_URL=http://user:pass@proxy:8080
# Route Anthropic API traffic through a proxy (other providers stay direct).
# CODEX_ANTHROPIC_PROXY_URL=http://user:pass@proxy:8080
# TLS fingerprint strategy: bun (default), rustls, bun-all, or off.
# CODEX_TLS_FINGERPRINT=bun
# Skip token refresh entirely (some auth.json fixtures fail refresh).
# PROXY_DISABLE_REFRESH=true

# Codex client identity / fingerprint updater.
# CODEX_USER_AGENT=
# CODEX_FINGERPRINT_AUTO_UPDATE=0
# CODEX_FINGERPRINT_UPDATE_SECONDS=86400
# Persist fingerprint updater state to a file (empty = stateless).
# CODEX_FINGERPRINT_STATE_PATH=/app/data/codex_fingerprint.json
# CODEX_APPCAST_URL=
# Override vendor client versions reported upstream.
# GROK_CLIENT_VERSION=
# ANTIGRAVITY_CLIENT_VERSION=

# OAuth client overrides (default: the public CLI client of each vendor).
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_REDIRECT_URI=

# ----------------------------------------------------------------------------
# Upstream endpoints (defaults point at the vendor endpoints; override only
# for testing or self-hosted gateways)
# ----------------------------------------------------------------------------

# UPSTREAM_RESPONSES_BASE=https://chatgpt.com/backend-api/codex
# UPSTREAM_REALTIME_BASE=https://api.openai.com
# UPSTREAM_WHAM_BASE=https://chatgpt.com/backend-api
# UPSTREAM_REFRESH_BASE=https://auth.openai.com
# UPSTREAM_CLAUDE_BASE=https://api.anthropic.com
# UPSTREAM_GEMINI_BASE=https://cloudcode-pa.googleapis.com
# UPSTREAM_GEMINI_API_BASE=https://generativelanguage.googleapis.com
# UPSTREAM_ANTIGRAVITY_BASE=https://cloudcode-pa.googleapis.com
# UPSTREAM_ANTIGRAVITY_DAILY_BASE=https://daily-cloudcode-pa.googleapis.com
# UPSTREAM_ANTIGRAVITY_ONBOARD_BASE=https://daily-cloudcode-pa.googleapis.com
# UPSTREAM_KIMI_BASE=https://api.kimi.com/coding
# UPSTREAM_MINIMAX_BASE=https://api.minimax.io/anthropic
# UPSTREAM_ZAI_BASE=https://api.z.ai/api/anthropic
# UPSTREAM_XIAOMI_BASE=https://token-plan-sgp.xiaomimimo.com/anthropic
# UPSTREAM_GROK_BASE=https://cli-chat-proxy.grok.com/v1
# UPSTREAM_ADVERSERIAL_BASE=https://platform.adverserial.ai/api
# UPSTREAM_OPENCODE_GO_BASE=https://opencode.ai/zen/go/v1

# ----------------------------------------------------------------------------
# Debug
# ----------------------------------------------------------------------------

# PROXY_DEBUG=true
# Alias checked on config hot-reload (startup reads PROXY_DEBUG instead).
# DEBUG=true
