# Codex Pool Proxy Configuration
# Copy this file to config.toml and customize as needed.
# Environment variables take precedence over config file values.

# Server settings
listen_addr = "127.0.0.1:8989"
pool_dir = "pool"
db_path = "./data/proxy.db"
max_attempts = 3
disable_refresh = false
debug = false
# Max request body size to buffer in memory before streaming (bytes).
# Set via env PROXY_MAX_INMEM_BODY_BYTES (default 16777216).

# Public URL for generated configs and instructions
# Use this when behind a reverse proxy or using a custom domain
# Example: "https://proxy.example.com" or "http://192.168.1.100:8989"
public_url = ""

# Grok Code upstream and accounts
# Accounts are loaded from pool/grok/*.json. You can paste/import ~/.grok auth JSON
# from the friend admin page, or place pi-grok/simple auth JSON in that directory.
grok_base = "https://cli-chat-proxy.grok.com/v1"

# Transitional Passport enrollment code. It never authorizes ordinary requests;
# existing holders may use it once to choose a username/password. Clear it after
# migration. The first boot separately persists its value as the analytics salt.
friend_code = ""

# Legacy pool-user storage imported into Passport on first start.
[pool_users]
# Secret key retained for validating existing signed client credentials.
jwt_secret = ""

# Where to store pool user data
storage_path = "./data/pool_users.json"

# Optional model name aliases (short name -> upstream model).
# Built-in defaults always include: gpt-5.6 -> gpt-5.6-sol
# Entries here override built-ins.
# [model_aliases]
# "gpt-5.6" = "gpt-5.6-sol"

# Smart Router policy. Requests may override this with:
#   X-Pool-Routing: fast
# or model aliases such as pool/quota-saver/gpt-5.6.
[routing]
default_profile = "balanced"
default_model = "gpt-5.5"

# Built-in profiles: balanced, fast, throughput, quota-saver, drain, sticky.
# Set default_profile = "legacy" to retain the pre-Smart-Router selector.
# A complete profile whose weights total 1 replaces the built-in weights.
[routing.profiles.balanced]
quota_headroom = 0.25
reset_urgency = 0.15
health = 0.20
ttft = 0.10
throughput = 0.10
affinity = 0.10
inflight = 0.05
recent_failure = 0.05
